page{background:#f4f5f7;color:#243349;font-family:-apple-system,BlinkMacSystemFont,"PingFang SC","Microsoft YaHei",sans-serif;font-size:28rpx}view,text,input,textarea,button,picker{box-sizing:border-box}button::after{border:0}button{font-size:28rpx;border-radius:20rpx;font-weight:600}input,textarea{font-size:28rpx;color:#243349}.placeholder{color:#9aa3af;font-weight:400}switch{flex-shrink:0;transform:scale(.82);transform-origin:right center}button:active{opacity:.86}
