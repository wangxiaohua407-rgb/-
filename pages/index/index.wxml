<view class="page">
  <view class="hero">
    <view class="hero-snow"></view>
    <view class="brand"><text class="brand-mark">雪</text><view><view class="brand-name">雪谷小满客栈</view><view class="brand-en">XIAOMAN · XUEGU</view></view><text class="brand-tag">行程规划</text></view>
    <view class="hero-title">赴一场雪约<view>把旅程安排好</view></view>
    <view class="hero-subtitle">从中央大街出发，到雪谷慢慢玩。</view>
    <view class="hero-tags"><text>直通车接送</text><text>客栈住宿</text><text>雪山体验</text></view>
    <view class="hero-bottom"><text>填写行程 · 选择项目 · 生成专属报价</text><text>↓</text></view>
  </view>

  <view class="content">
    <view class="section-title"><view><text class="section-number">01</text><text>先安排出行</text></view><text class="section-caption">你的雪谷之旅</text></view>
    <view class="card trip-card">
      <view class="field"><text class="field-label">客户姓名</text><input class="field-input" placeholder="怎么称呼你？" value="{{form.customer}}" data-field="customer" bindinput="field" maxlength="30" placeholder-class="placeholder"/></view>
      <view class="field"><text class="field-label">出发日期（选填）</text><picker mode="date" value="{{form.date}}" data-field="date" bindchange="field"><view class="field-value {{form.date ? '' : 'muted'}}">{{form.date || '暂未确定日期'}}<text class="chevron">›</text></view></picker></view>
      <view class="hint">不用确定具体日期，先按第一天、第二天、第三天安排。</view><view wx:if="{{form.date}}" class="detail-toggle" bindtap="clearDate">清除具体日期，按天数安排行程</view><view class="trip-grid">
        <view class="stat-field"><text>出行人数</text><view><input type="number" value="{{form.people}}" data-field="people" bindinput="field"/><text>人</text></view></view>
        <view class="stat-field"><text>住宿晚数</text><view><input type="number" value="{{form.nights}}" data-field="nights" bindinput="field"/><text>晚</text></view></view>
        <view class="stat-field"><text>房间数量</text><view><input type="number" value="{{form.rooms}}" data-field="rooms" bindinput="field"/><text>间</text></view></view>
      </view>
    </view>

    <view class="section-title"><view><text class="section-number">02</text><text>选择旅途体验</text></view><text class="section-caption">按需开启项目</text></view>
    <view class="card experience-card" wx:for="{{form.items}}" wx:key="key">
      <view class="card-top"><view class="experience-title"><text class="item-mark mark-{{item.key}}">{{index + 1}}</text><view><view class="card-name">{{item.name}}</view><view class="card-subtitle">{{item.key === 'transport' ? '选好班次，安心出发' : item.key === 'stay' ? '住进雪谷的温暖夜晚' : item.key === 'wusong' ? '雾凇、摩托与山顶风景' : item.key === 'yangcao' ? '穿越雪山，或套票畅玩' : item.key === 'circle' ? '100元 / 人 · 约半小时' : '200元 / 人 · 雪谷内游玩'}}</view></view></view><switch color="#b58745" checked="{{item.enabled}}" data-index="{{index}}" data-field="enabled" bindchange="item"/></view>
      <view wx:if="{{!item.enabled}}" class="disabled-note">本次行程不包含此项目</view>
      <block wx:if="{{item.enabled}}">
        <block wx:if="{{item.key === 'transport'}}">
          <picker range="{{['选择直通车线路','手动填写车费']}}" value="{{form.transportType === 'routes' ? 0 : 1}}" bindchange="transport"><view class="select-box compact">{{form.transportType === 'routes' ? '直通车 · 固定班次' : '手动填写车费'}}<text class="chevron">⌄</text></view></picker>
          <block wx:if="{{form.transportType === 'routes'}}">
            <view class="route-section"><text class="small-label">去程线路</text><picker range="{{routeLabels}}" value="{{outboundIndex}}" data-field="outbound" bindchange="route"><view class="select-box">{{routeLabels[outboundIndex]}}<text class="chevron">⌄</text></view></picker>
              <view wx:if="{{outboundRoute}}" class="duration-tag">车程约{{outboundRoute.duration}} · 每人{{outboundRoute.price}}元</view>
              <view wx:if="{{outboundRoute}}" class="field"><text class="field-label">发车班次</text><picker range="{{outboundTimes}}" value="{{form.outbound === '0' ? outboundTimeIndex : otherOutboundTimeIndex}}" data-field="{{form.outbound === '0' ? 'outboundTime' : 'otherOutboundTime'}}" data-options="outboundTimes" bindchange="fixedDeparture"><view class="field-value">{{(form.outbound === '0' ? form.outboundTime : form.otherOutboundTime) || '选择固定班次'}}<text class="chevron">⌄</text></view></picker></view>
              <view wx:if="{{form.outbound === '0'}}" class="tip"><text class="tip-mark">i</text><text>6:00班车可接当天午间雾凇岭；8:00及午间班车请安排次日。</text></view>
            </view>
            <view class="route-section"><text class="small-label">返程 / 第二段线路</text><picker range="{{routeLabels}}" value="{{inboundIndex}}" data-field="inbound" bindchange="route"><view class="select-box">{{routeLabels[inboundIndex]}}<text class="chevron">⌄</text></view></picker>
              <block wx:if="{{inboundRoute}}"><view class="duration-tag">车程约{{inboundRoute.duration}} · 每人{{inboundRoute.price}}元</view><view class="field"><text class="field-label">返程安排</text><picker range="{{dayLabels}}" value="{{form.inboundDay}}" data-field="inboundDay" bindchange="selectDay"><view class="field-value">{{dayLabels[form.inboundDay]}}<text class="chevron">⌄</text></view></picker></view><view class="field"><text class="field-label">发车班次</text><picker range="{{inboundTimes}}" value="{{inboundTimeIndex}}" data-field="inboundTime" data-options="inboundTimes" bindchange="fixedDeparture"><view class="field-value">{{form.inboundTime || '选择固定班次'}}<text class="chevron">⌄</text></view></picker></view></block>
            </view>
            <view class="subtotal"><text>所选车程 / 人</text><text class="subtotal-price">¥{{routeFare}}</text></view>
            <view class="hint">只坐单程？将另一段选为“不含此车程”。</view>
            <view wx:if="{{form.outbound === '14' || form.inbound === '14'}}" class="tip">联乘可在雪乡游玩、行李留车上，再按所选18:00或20:00班次去雪谷。</view>
          </block>
        </block>

        <view wx:if="{{(item.key !== 'transport' || form.transportType !== 'routes') && (item.key !== 'wusong' || !form.wusongPackage) && (item.key !== 'yangcao' || !form.yangcaoOptions)}}" class="manual-pricing"><text class="small-label">计费方式</text><picker range="{{item.units}}" value="{{item.mode}}" data-index="{{index}}" data-field="mode" bindchange="item"><view class="select-box">{{item.units[item.mode]}}<text class="chevron">⌄</text></view></picker><view class="field"><text class="field-label">单价</text><view class="price-input"><text>¥</text><input type="digit" placeholder="请输入价格" value="{{item.price}}" data-index="{{index}}" data-field="price" bindinput="item" placeholder-class="placeholder"/></view></view></view>

        <block wx:if="{{item.key === 'wusong'}}">
          <block wx:if="{{form.wusongPackage}}"><view class="package-price"><view><text class="price-label">全项目套票</text><view><text class="big-price">400</text><text class="price-unit">元 / 位</text></view></view><text class="badge">现金支付</text></view>
            <view class="field"><view><text class="field-label">半票人数</text><view class="hint">1米至不足1.2米 · 200元/位</view></view><view class="count-input"><input type="number" value="{{form.wusongHalf}}" data-field="wusongHalf" bindinput="field"/><text>人</text></view></view>
            <view class="field"><view><text class="field-label">免票人数</text><view class="hint">不足1米 · 包含在总人数中</view></view><view class="count-input"><input type="number" value="{{form.wusongFree}}" data-field="wusongFree" bindinput="field"/><text>人</text></view></view>
          </block><view wx:else class="tip">这是旧版历史报价，保留原价；新建报价使用最新套票规则。</view>
          <view class="field"><text class="field-label">游玩安排</text><picker range="{{dayLabels}}" value="{{form.wusongDay}}" data-field="wusongDay" bindchange="selectDay"><view class="field-value">{{dayLabels[form.wusongDay]}}<text class="chevron">⌄</text></view></picker></view>
          <view class="field"><text class="field-label">上山班次</text><picker range="{{wusongTimes}}" value="{{wusongTimeIndex}}" bindchange="wusongTime"><view class="field-value">{{form.wusongTime || '选择上山时间'}}<text class="chevron">⌄</text></view></picker></view>
          <view wx:if="{{scheduleMessage}}" class="schedule-warning">{{scheduleMessage}}</view>
          <view class="detail-toggle" data-key="wusong" bindtap="toggleDetails"><text>{{detailOpen.wusong ? '收起套票与接送说明' : '查看套票与接送说明'}}</text><text>{{detailOpen.wusong ? '−' : '+'}}</text></view>
          <view wx:if="{{detailOpen.wusong}}" class="details"><view>往返接送到山脚，车程约30分钟；返程车辆陆续发车。</view><view>包含：山脚至山顶往返雪地摩托、摩托丛林穿越、赏雾凇、山顶看日落、山顶摩托自驾、滑雪、雪爬犁、雪地长龙、雪地龙舟、雪飘。</view><view>现金支付，没有现金可找客栈老板换。每天小满老爸免费带玩，360全景相机免费拍视频记录。</view></view>
        </block>

        <block wx:if="{{item.key === 'circle' || item.key === 'ski'}}">
          <view wx:if="{{item.key === 'circle'}}" class="tip">雪谷内马拉爬犁跑圈约半小时，与羊草山进山马拉爬犁为不同项目。</view>
          <view class="field"><text class="field-label">游玩安排</text><picker range="{{dayLabels}}" value="{{item.key === 'circle' ? form.circleDay : form.skiDay}}" data-field="{{item.key === 'circle' ? 'circleDay' : 'skiDay'}}" bindchange="selectDay"><view class="field-value">{{dayLabels[item.key === 'circle' ? form.circleDay : form.skiDay]}}<text class="chevron">⌄</text></view></picker></view>
          <view class="field"><text class="field-label">开始时间</text><picker mode="time" value="{{item.key === 'circle' ? form.circleTime : form.skiTime}}" data-field="{{item.key === 'circle' ? 'circleTime' : 'skiTime'}}" bindchange="field"><view class="field-value">{{(item.key === 'circle' ? form.circleTime : form.skiTime) || '待定'}}<text class="chevron">›</text></view></picker></view>
        </block>
        <block wx:if="{{item.key === 'yangcao' && form.yangcaoOptions}}">
          <text class="small-label">选择玩法</text><picker range="{{yangcaoPlanLabels}}" value="{{form.yangcaoPlan}}" bindchange="yangcaoPlan"><view class="select-box">{{yangcaoPlanLabels[form.yangcaoPlan]}}<text class="chevron">⌄</text></view></picker>
          <view wx:if="{{form.yangcaoPlan == 1}}" class="package-panel"><view class="package-price"><view><text class="price-label">羊草山套票</text><view><text class="big-price">550</text><text class="price-unit">元 / 人</text></view></view><text class="badge">不去雪乡</text></view><view class="package-includes">马拉爬犁往返 · 天下第一漂 · 雪地摩托车</view><view class="hint">包含项目不再加价，无需雪乡回雪谷车票。儿童优惠待确认，暂按550元/人计。</view></view>
          <block wx:if="{{form.yangcaoPlan == 0}}"><view class="subtotal"><text>穿越基础门票 / 人</text><text class="subtotal-price">¥40</text></view><view class="field"><view><text class="field-label">免门票人数</text><view class="hint">不足1.2米 · 其他项目单独计费</view></view><view class="count-input"><input type="number" value="{{form.yangcaoFree}}" data-field="yangcaoFree" bindinput="field"/><text>人</text></view></view>
            <view class="field"><view><text class="field-label">马拉爬犁 · 100元/人</text><view class="hint">雪谷至茶房约5公里 · 省力进山</view></view><switch color="#b58745" checked="{{form.yangcaoHorse}}" data-field="yangcaoHorse" bindchange="field"/></view>
            <text class="small-label">上山雪地摩托</text><picker range="{{yangcaoSnowLabels}}" value="{{form.yangcaoSnow}}" data-field="yangcaoSnow" bindchange="field"><view class="select-box">{{yangcaoSnowLabels[form.yangcaoSnow]}}<text class="chevron">⌄</text></view></picker>
            <text class="small-label">雪飘方向 · 二选一</text><picker range="{{yangcaoSlideLabels}}" value="{{form.yangcaoSlideMode}}" data-field="yangcaoSlideMode" bindchange="field"><view class="select-box">{{yangcaoSlideLabels[form.yangcaoSlideMode]}}<text class="chevron">⌄</text></view></picker>
            <view class="hint">加选项目按全部出行人数计费。</view>
          </block>
          <view class="field"><text class="field-label">游玩安排</text><picker range="{{dayLabels}}" value="{{form.yangcaoDay}}" data-field="yangcaoDay" bindchange="selectDay"><view class="field-value">{{dayLabels[form.yangcaoDay]}}<text class="chevron">⌄</text></view></picker></view>
          <view class="field"><text class="field-label">出发时间</text><picker mode="time" value="{{form.yangcaoTime}}" data-field="yangcaoTime" bindchange="field"><view class="field-value">{{form.yangcaoTime || '待定'}}<text class="chevron">›</text></view></picker></view>
          <view class="detail-toggle" data-key="yangcao" bindtap="toggleDetails"><text>{{detailOpen.yangcao ? '收起路线说明' : '查看穿越路线与项目说明'}}</text><text>{{detailOpen.yangcao ? '−' : '+'}}</text></view>
          <view wx:if="{{detailOpen.yangcao}}" class="details"><view>雪谷 → 茶房 → 山顶 → 雪乡，全程约15公里，上山约10公里、下山约5公里；穿越出发9:00–11:00。</view><view>茶房至山顶全程摩托覆盖5公里；半程仅覆盖后2.5公里，前半段需徒步。</view><view>80元雪飘向雪乡滑行约3公里；150元天下第一漂往雪谷方向返回茶房，方向不同。</view></view>
        </block>
      </block>
    </view>

    <view wx:if="{{!(form.items[3].enabled && form.yangcaoOptions && form.yangcaoPlan == 1)}}" class="card night-card"><view class="card-top"><view><view class="card-name">晚上从雪乡回雪谷</view><view class="card-subtitle">60元 / 人 · 车程约2小时</view></view><switch color="#b58745" checked="{{form.nightReturn}}" data-field="nightReturn" bindchange="field"/></view><block wx:if="{{form.nightReturn}}"><view class="field"><text class="field-label">返程安排</text><picker range="{{dayLabels}}" value="{{form.nightReturnDay}}" data-field="nightReturnDay" bindchange="selectDay"><view class="field-value">{{dayLabels[form.nightReturnDay]}}<text class="chevron">⌄</text></view></picker></view><view class="field"><text class="field-label">固定班次</text><picker range="{{nightReturnTimes}}" value="{{nightReturnTimeIndex}}" data-field="nightReturnTime" data-options="nightReturnTimes" bindchange="fixedDeparture"><view class="field-value">{{form.nightReturnTime || '选择18:00或20:00'}}<text class="chevron">⌄</text></view></picker></view><view class="hint">直通车已包含同一车票时，不会重复收费。</view></block></view>
    <view class="card supplemental-card">
      <view class="card-top"><view><view class="card-name">补充车费</view><view class="card-subtitle">去雪乡、包车回雪谷等额外用车</view></view><switch color="#b58745" checked="{{form.supplementEnabled}}" data-field="supplementEnabled" bindchange="field"/></view>
      <block wx:if="{{form.supplementEnabled}}">
        <view class="tip">这里只添加未计入直通车或60元夜间返程票的费用，避免重复。</view>
        <view class="supplement-trip" wx:for="{{form.supplementTrips}}" wx:for-item="trip" wx:for-index="tripIndex" wx:key="id">
          <view class="supplement-heading"><text>补充用车 {{tripIndex + 1}}</text><button class="remove-trip" data-index="{{tripIndex}}" bindtap="removeTrip">移除</button></view>
          <picker range="{{supplementRoutes}}" value="{{trip.route}}" data-index="{{tripIndex}}" data-field="route" bindchange="supplementField"><view class="select-box">{{supplementRoutes[trip.route]}}<text class="chevron">⌄</text></view></picker>
          <view wx:if="{{trip.route == 2}}" class="field"><text class="field-label">用车说明</text><input class="field-input" placeholder="填写出发地和目的地" value="{{trip.label}}" maxlength="40" data-index="{{tripIndex}}" data-field="label" bindinput="supplementField"/></view>
          <text class="small-label">计费方式</text><picker range="{{supplementModes}}" value="{{trip.mode}}" data-index="{{tripIndex}}" data-field="mode" bindchange="supplementField"><view class="select-box">{{supplementModes[trip.mode]}}<text class="chevron">⌄</text></view></picker>
          <view class="field"><text class="field-label">{{trip.mode == 1 ? '整车总价' : '每人单价'}}</text><view class="price-input"><text>¥</text><input type="digit" value="{{trip.price}}" placeholder="填写实际价格" data-index="{{tripIndex}}" data-field="price" bindinput="supplementField"/></view></view>
          <view wx:if="{{trip.mode == 0}}" class="field"><text class="field-label">乘车人数</text><input class="field-input" type="number" value="{{trip.people}}" placeholder="{{'默认' + form.people + '人'}}" data-index="{{tripIndex}}" data-field="people" bindinput="supplementField"/></view>
          <view class="field"><text class="field-label">用车安排</text><picker range="{{dayLabels}}" value="{{trip.day}}" data-index="{{tripIndex}}" data-field="day" bindchange="supplementField"><view class="field-value">{{dayLabels[trip.day]}}<text class="chevron">⌄</text></view></picker></view>
          <view class="field"><text class="field-label">出发时间</text><picker mode="time" value="{{trip.time}}" data-index="{{tripIndex}}" data-field="time" bindchange="supplementField"><view class="field-value">{{trip.time || '待定'}}<text class="chevron">›</text></view></picker></view>
        </view>
        <button class="add-trip" bindtap="addTrip">＋ 再添加一段用车</button>
      </block>
    </view>
    <view class="card note-card"><text class="small-label">给客户的备注</text><textarea placeholder="例如集合地点、餐费说明、需要带的物品…" value="{{form.note}}" data-field="note" bindinput="field" maxlength="100" placeholder-class="placeholder" auto-height/></view>
    <button class="primary" bindtap="quote">生成我的行程与报价<text> →</text></button><view class="generate-hint">确认日期、班次和费用后，即可生成客户行程单</view>

    <view wx:if="{{result}}" class="result-section">
      <view class="section-title"><view><text class="section-number">03</text><text>你的专属行程</text></view><text class="section-caption">可保存 · 可分享</text></view>
      <view class="summary"><view class="result-header"><view class="result-brand">雪谷小满客栈</view><view class="result-title">{{form.customer || '客户'}}的雪谷行程</view><text class="result-meta">{{form.people}}位出行 · 住宿{{form.nights}}晚 · {{form.rooms}}间房</text></view>
        <view class="timeline"><view wx:for="{{result.itinerary}}" wx:key="index" class="timeline-entry"><view class="timeline-dot"></view><view class="timeline-time">{{item.dateLabel}} · {{item.time}}</view><view class="timeline-title">{{item.title}}</view><view class="hint">{{item.detail}}</view></view></view>
        <view class="bill"><view class="heading">费用明细</view><block wx:for="{{result.lines}}" wx:key="name"><view wx:if="{{item.enabled}}" class="bill-row"><view><view>{{item.name}}</view><view class="bill-detail">{{item.detail || ('¥' + item.price + ' × ' + item.qty)}}</view></view><text class="bill-price">¥{{item.amount}}</text></view></block><view class="bill-total"><view><view class="small-label">行程总价</view><view class="total"><text class="currency">¥</text>{{result.total}}</view></view><view class="per-person">人均约<view>¥{{result.perPerson}}</view></view></view></view>
        <view wx:if="{{form.note}}" class="result-note">备注：{{form.note}}</view><view class="hint result-disclaimer">预计时间以路况及实际安排为准；报价仅含列明项目。</view>
      </view>
      <button class="primary" bindtap="copyItinerary">复制文字行程 · 发给客户</button><view class="actions"><button bindtap="poster">生成行程图片</button><button bindtap="save">保存这份报价</button></view>
    </view>
    <view class="secondary-actions"><button bindtap="reset">新建一份行程</button><button open-type="share">分享小程序</button></view>
    <view wx:if="{{history.length}}" class="card history-card"><view class="heading">最近保存的行程<text class="history-caption">本机记录</text></view><view wx:for="{{history}}" wx:key="id" class="history-row" data-id="{{item.id}}" bindtap="restore"><text>{{item.label}}</text><view><text>¥{{item.total}}</text><text class="chevron">›</text></view></view></view>
    <view class="footer"><view>雪谷小满客栈</view><text>把时间留给风景，把安排交给我们</text></view>
  </view>
  <canvas canvas-id="quoteCanvas" style="position:fixed;left:-2000px;width:600px;height:{{posterHeight}}px"/>
</view>
