.page{padding:40rpx 30rpx}.hero{padding:30rpx 8rpx 50rpx}.eyebrow{font-size:22rpx;letter-spacing:4rpx;color:#287d7a}.title{font-size:46rpx;font-weight:700;line-height:1.5;margin:22rpx 0}.subtitle{font-size:25rpx;color:#668389}.card{background:white;border-radius:26rpx;padding:30rpx;margin-bottom:28rpx}.heading{font-size:29rpx;font-weight:700;margin-bottom:22rpx}.row{display:flex;align-items:center;justify-content:space-between;gap:20rpx;min-height:80rpx;font-size:28rpx}.row input{text-align:right;width:330rpx}.hint{font-size:23rpx;color:#668389;line-height:1.7}.fee{border-bottom:1rpx solid #e5eeee;padding:12rpx 0 22rpx}.fee-name{font-weight:600}.pill{background:#eef7f7;padding:14rpx 20rpx;border-radius:12rpx;font-size:25rpx}.price{display:flex;align-items:center;gap:12rpx}.price input{width:190rpx}.primary{background:#236d6b;color:white;padding:14rpx}.summary{background:#dbeee9;border-radius:26rpx;padding:34rpx;margin:28rpx 0}.total{font-size:66rpx;font-weight:700;margin-top:22rpx}.actions{display:flex;gap:18rpx;margin:26rpx 0}.actions button{flex:1;background:white;color:#236d6b;margin:0;padding:8rpx}.footer{text-align:center;font-size:23rpx;color:#668389;margin:38rpx}

.route-label{font-size:26rpx;margin:22rpx 0 12rpx}

